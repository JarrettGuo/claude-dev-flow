{
  "$comment": "项目级 Claude Code 设置。hooks 用来为 flow-log 能力提供自动记录。脚本位于 .claude/hooks/flow-log.sh。",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/flow-log.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/flow-log.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/flow-log.sh"
          }
        ]
      }
    ]
  }
}
